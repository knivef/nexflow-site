# Copy to .env for local development. On Vercel, set these under Project Settings > Environment Variables.

# Public production URL, used for canonical tags, sitemap and schema. No trailing slash.
SITE_URL=https://nexflow.example

# How partner applications are delivered: none | webhook | notion | email
# "none" rejects submissions with a friendly error that shows the fallback email address.
FORM_ADAPTER=none

# webhook adapter: applications are POSTed as JSON to this URL (Zapier, Make, n8n, Slack workflow, your own API).
FORM_ENDPOINT=
# Optional. If set, each webhook request carries an X-Nexflow-Signature header: hex HMAC-SHA256 of the raw body.
FORM_WEBHOOK_SECRET=

# notion adapter: an internal integration token and the ID of a database shared with that integration.
# Expected database properties are listed in README.md.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# email adapter (stub, not implemented yet): where applications would be sent.
FORM_EMAIL_TO=

# Optional call booking link (e.g. Cal.com or Calendly). Shown as "Book a call" and embedded after a successful application.
BOOKING_URL=

# Privacy-friendly analytics domain (e.g. Plausible). Leave empty to disable analytics.
ANALYTICS_DOMAIN=
