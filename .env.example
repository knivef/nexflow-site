# NexFlow site environment. Copy to .env and fill in. Never commit .env.

# Public site URL, used for canonical tags and the sitemap.
SITE_URL="http://localhost:4321"

# Where the account, partner and sales forms send submissions.
# One of: none, webhook, notion, email. "none" logs and returns success without storing.
FORM_ADAPTER="none"

# Used when FORM_ADAPTER="webhook".
FORM_ENDPOINT=""

# Used when FORM_ADAPTER="notion".
NOTION_TOKEN=""
NOTION_DB_ACCOUNTS=""
NOTION_DB_PARTNERS=""
NOTION_DB_SALES=""

# Privacy-friendly analytics domain. Leave empty to disable analytics entirely.
ANALYTICS_DOMAIN=""
