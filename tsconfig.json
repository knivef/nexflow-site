{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@v2/*": [
        "src/v2/*"
      ],
      "@v3/*": [
        "src/v3/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ]
    }
  }
}
