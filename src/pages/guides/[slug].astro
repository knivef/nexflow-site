---
/**
 * Guide pages from the guides content collection (src/content/guides). Drafts are not built.
 */
import { getCollection, render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import { organizationNode } from '@/lib/schema';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const base = Astro.site ?? new URL('http://localhost:4321');
const url = new URL(Astro.url.pathname, base).href;
const organizationId = organizationNode(base)['@id'];

const article = {
  '@type': 'Article',
  '@id': `${url}#article`,
  headline: guide.data.title,
  description: guide.data.description,
  datePublished: guide.data.publishedAt.toISOString(),
  ...(guide.data.updatedAt && { dateModified: guide.data.updatedAt.toISOString() }),
  author: { '@id': organizationId },
  publisher: { '@id': organizationId },
  mainEntityOfPage: url,
};
---

<PageLayout title={`${guide.data.title} | Nexflow`} description={guide.data.description} type="article" schema={[article]}>
  <article class="guide container">
    <h1 class="t-heading-lg">{guide.data.title}</h1>
    <div class="guide__body t-body">
      <Content />
    </div>
  </article>
</PageLayout>

<style>
  .guide {
    max-width: 760px;
    padding-block: var(--section-padding-block);
  }

  .guide__body {
    display: grid;
    gap: var(--spacing-16);
    margin-top: var(--spacing-40);
    color: var(--text-primary);
  }

  .guide__body :global(h2) {
    margin-top: var(--spacing-32);
    font-family: var(--font-serif);
    font-size: var(--text-heading-sm);
    font-weight: var(--font-weight-regular);
    letter-spacing: -0.02em;
  }
</style>
