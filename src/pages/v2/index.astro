---
import PageLayout from '@v2/layouts/PageLayout.astro';
import Hero from '@v2/components/sections/Hero.astro';
import Who from '@v2/components/sections/Who.astro';
import Problem from '@v2/components/sections/Problem.astro';
import How from '@v2/components/sections/How.astro';
import Network from '@v2/components/sections/Network.astro';
import Features from '@v2/components/sections/Features.astro';
import Verticals from '@v2/components/sections/Verticals.astro';
import Partners from '@v2/components/sections/Partners.astro';
import Trust from '@v2/components/sections/Trust.astro';
import Compare from '@v2/components/sections/Compare.astro';
import Merchants from '@v2/components/sections/Merchants.astro';
import Faq from '@v2/components/sections/Faq.astro';
import Apply from '@v2/components/sections/Apply.astro';
import { faqPageNode, serviceNode } from '@v2/lib/schema';

const base = Astro.site ?? new URL('http://localhost:4321');
// Section order and anchor ids follow CLAUDE.md. v2 has no #founding-partners section.
---

<PageLayout schema={[serviceNode(base), faqPageNode(base)]}>
  <Hero />
  <Who />
  <Problem />
  <How />
  <Network />
  <Features />
  <Verticals />
  <Partners />
  <Trust />
  <Compare />
  <Merchants />
  <Faq />
  <Apply />
</PageLayout>
