---
/**
 * Accessible tabs (WAI-ARIA tabs pattern, automatic activation).
 * Pass panels as named slots matching each tab id, e.g. <div slot="igaming">...</div>.
 * Arrow keys move between tabs, Home and End jump to first and last.
 * With deepLink, each panel's id is {id}-{tab.id} (e.g. #verticals-igaming): opening that URL selects the tab,
 * and selecting a tab updates the URL hash without adding history entries.
 */
interface Tab {
  id: string;
  label: string;
}

interface Props {
  /** Unique prefix for ids on the page. */
  id: string;
  /** Accessible name for the tab list. */
  label: string;
  tabs: Tab[];
  defaultTab?: string;
  deepLink?: boolean;
}

const { id, label, tabs, defaultTab, deepLink = false } = Astro.props;
const panelId = (tabId: string) => (deepLink ? `${id}-${tabId}` : `${id}-panel-${tabId}`);
const selected = defaultTab ?? tabs[0]?.id;

const panels = await Promise.all(
  tabs.map(async (tab) => ({
    ...tab,
    html: Astro.slots.has(tab.id) ? await Astro.slots.render(tab.id) : '',
  })),
);
---

<div class="tabs" data-tabs data-deep-link={deepLink ? '' : undefined}>
  <div class="tabs__list" role="tablist" aria-label={label}>
    {
      tabs.map((tab) => (
        <button
          type="button"
          role="tab"
          class="tabs__tab"
          id={`${id}-tab-${tab.id}`}
          aria-controls={panelId(tab.id)}
          aria-selected={tab.id === selected ? 'true' : 'false'}
          tabindex={tab.id === selected ? 0 : -1}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  {
    panels.map((panel) => (
      <div
        class="tabs__panel"
        role="tabpanel"
        id={panelId(panel.id)}
        aria-labelledby={`${id}-tab-${panel.id}`}
        tabindex="0"
        hidden={panel.id !== selected}
        set:html={panel.html}
      />
    ))
  }
</div>

<script>
  function initTabs(root: HTMLElement) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const deepLink = root.hasAttribute('data-deep-link');

    function select(next: HTMLButtonElement, { focus = true, updateHash = deepLink } = {}) {
      for (const tab of tabs) {
        const active = tab === next;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !active;
      }
      if (focus) next.focus();
      if (updateHash) history.replaceState(null, '', `#${next.getAttribute('aria-controls')}`);
    }

    root.addEventListener('click', (event) => {
      const tab = (event.target as HTMLElement).closest<HTMLButtonElement>('[role="tab"]');
      if (tab) select(tab, { focus: false });
    });

    root.addEventListener('keydown', (event) => {
      const current = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (current === -1) return;
      const keys: Record<string, number> = {
        ArrowRight: (current + 1) % tabs.length,
        ArrowLeft: (current - 1 + tabs.length) % tabs.length,
        Home: 0,
        End: tabs.length - 1,
      };
      const target = keys[event.key];
      if (target === undefined) return;
      event.preventDefault();
      select(tabs[target]!);
    });

    if (deepLink) {
      // Open the tab named in the URL hash, then bring the whole tab set (not just the panel) into view.
      const fromHash = (behavior: ScrollBehavior) => {
        const hash = decodeURIComponent(location.hash.slice(1));
        const tab = tabs.find((t) => t.getAttribute('aria-controls') === hash);
        if (!tab) return;
        select(tab, { focus: false, updateHash: false });
        root.scrollIntoView({ block: 'start', behavior });
      };
      // On first load, jump once layout and fonts have settled. The browser can't do this itself
      // because the target panel was hidden when it looked for the fragment.
      if (document.readyState === 'complete') fromHash('instant');
      else window.addEventListener('load', () => fromHash('instant'), { once: true });
      window.addEventListener('hashchange', () => fromHash('auto'));
    }
  }

  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach(initTabs);
</script>

<style>
  .tabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-8);
    margin-bottom: var(--spacing-40);
  }

  .tabs__tab {
    min-height: 44px;
    padding: 12px 20px;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-pills);
    background: transparent;
    color: var(--text-primary);
    font-size: var(--text-body-sm);
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .tabs__tab:hover {
    border-color: var(--border-strong);
  }

  .tabs__tab[aria-selected='true'] {
    background: var(--bg-inverse);
    border-color: var(--bg-inverse);
    color: var(--text-inverse);
  }

  .tabs__panel:focus-visible {
    outline-offset: 8px;
    border-radius: var(--radius-2xl);
  }
</style>
