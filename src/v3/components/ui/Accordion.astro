---
/**
 * Accordion list. Each item is a native <details>/<summary>, so it works without JavaScript
 * and is keyboard and screen reader accessible by default. Browser find-in-page also opens matching items.
 * Items with an id can be deep-linked: opening #that-id expands the item.
 */
interface Item {
  id?: string;
  question: string;
  /** Answer as trusted HTML from the content file. */
  answer: string;
}

interface Props {
  items: Item[];
  headingLevel?: 2 | 3 | 4;
}

const { items, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
---

<div class="accordion">
  {
    items.map((item) => (
      <details class="accordion__item" id={item.id}>
        <summary class="accordion__summary">
          <Heading class="accordion__question t-subheading">{item.question}</Heading>
          <span class="accordion__icon" aria-hidden="true">↓</span>
        </summary>
        <div class="accordion__answer t-body" set:html={item.answer} />
      </details>
    ))
  }
</div>

<script>
  // Open a deep-linked item on load and when the hash changes.
  const openFromHash = (behavior: ScrollBehavior) => {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    if (target instanceof HTMLDetailsElement && target.classList.contains('accordion__item')) {
      target.open = true;
      target.scrollIntoView({ block: 'start', behavior });
    }
  };
  // On first load, jump instantly once layout and fonts have settled; later hash changes follow the CSS scroll behaviour.
  if (document.readyState === 'complete') openFromHash('instant');
  else window.addEventListener('load', () => openFromHash('instant'), { once: true });
  window.addEventListener('hashchange', () => openFromHash('auto'));
</script>

<style>
  .accordion__item {
    border-bottom: 1px solid var(--border-hairline);
  }

  .accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-24);
    padding-block: var(--spacing-40);
    list-style: none;
    cursor: pointer;
  }

  .accordion__summary::-webkit-details-marker {
    display: none;
  }

  .accordion__summary:focus-visible {
    outline-offset: 6px;
    border-radius: var(--radius-2xl);
  }

  .accordion__question {
    font-size: var(--text-subheading);
  }

  .accordion__icon {
    flex-shrink: 0;
    font-size: var(--text-body-lg);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .accordion__item[open] .accordion__icon {
    transform: rotate(180deg);
  }

  .accordion__answer {
    max-width: 72ch;
    padding-bottom: var(--spacing-40);
  }

  .accordion__answer :global(p + p) {
    margin-top: var(--spacing-16);
  }
</style>
