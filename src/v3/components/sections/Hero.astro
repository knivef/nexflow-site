---
import { site } from '@v3/content/site';
import Button from '@v3/components/ui/Button.astro';
import { renderPlaceholders } from '@v3/lib/placeholder';

const { eyebrow, heading, subheading, primaryCta, secondaryCta, proofPoints } = site.hero;
---

<section id="hero" class="hero" aria-labelledby="hero-heading">
  <div class="hero__wash" aria-hidden="true">
    <span class="hero__blob hero__blob--warm"></span>
    <span class="hero__blob hero__blob--cool"></span>
  </div>

  <div class="container hero__inner">
    <p class="hero__eyebrow t-caption">{eyebrow}</p>
    <h1 id="hero-heading" class="hero__heading t-display">{heading}</h1>
    <p class="hero__subheading t-body-lg" set:html={renderPlaceholders(subheading)} />

    <div class="hero__ctas">
      <Button variant="primary" href={primaryCta.href} block>{primaryCta.label}</Button>
      {
        secondaryCta && (
          <Button variant="ghost" href={secondaryCta.href} arrow={false} block>
            {secondaryCta.label}
          </Button>
        )
      }
    </div>

    {
      proofPoints.length > 0 && (
        <ul class="hero__proof" role="list">
          {proofPoints.map((point) => (
            <li class="hero__proof-item t-body-sm" set:html={renderPlaceholders(point)} />
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(64px, 9vw, 136px) clamp(48px, 6vw, 80px);
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-pills);
    background: var(--bg-page);
    color: var(--text-primary);
  }

  .hero__heading {
    max-width: 18ch;
    margin-top: var(--spacing-32);
  }

  .hero__subheading {
    max-width: 62ch;
    margin-top: var(--spacing-32);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-16);
    margin-top: var(--spacing-40);
  }

  .hero__proof {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    width: 100%;
    margin-top: clamp(56px, 7vw, 96px);
    border-block: 1px solid var(--border-hairline);
    text-align: left;
  }

  .hero__proof-item {
    position: relative;
    padding: var(--spacing-24) var(--spacing-24) var(--spacing-24) calc(var(--spacing-24) + 20px);
    color: var(--text-primary);
  }

  .hero__proof-item::before {
    content: '';
    position: absolute;
    top: calc(var(--spacing-24) + 0.45em);
    left: var(--spacing-24);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-primary);
  }

  .hero__proof-item + .hero__proof-item {
    border-left: 1px solid var(--border-hairline);
  }

  /* Decorative atmospheric wash: blurred, low opacity, kept behind the headline so text contrast holds. */
  .hero__wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.45;
  }

  .hero__blob--warm {
    top: -12%;
    left: 8%;
    width: min(46vw, 620px);
    aspect-ratio: 1.4;
    background: radial-gradient(closest-side, var(--color-coral), var(--color-gold) 60%, transparent);
  }

  .hero__blob--cool {
    top: -6%;
    right: 6%;
    width: min(42vw, 560px);
    aspect-ratio: 1.3;
    background: radial-gradient(closest-side, var(--color-sky-blue), var(--color-mint) 65%, transparent);
  }

  @media (max-width: 1023px) {
    .hero__proof {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero__proof-item:nth-child(3) {
      border-left: 0;
    }

    .hero__proof-item:nth-child(n + 3) {
      border-top: 1px solid var(--border-hairline);
    }
  }

  @media (max-width: 599px) {
    .hero__ctas {
      flex-direction: column;
      width: 100%;
    }

    .hero__proof {
      grid-template-columns: 1fr;
    }

    .hero__proof-item + .hero__proof-item {
      border-left: 0;
      border-top: 1px solid var(--border-hairline);
    }

    .hero__blob {
      opacity: 0.35;
    }
  }
</style>
