---
/**
 * Testimonials and case studies. Renders nothing unless config.showTestimonials is true
 * AND there is at least one real entry. Never renders an empty shell or placeholder quotes.
 */
import { site } from '@v3/content/site';
import { config } from '@v3/config/site.config';
import { isReal } from '@v3/lib/placeholder';

const { heading, testimonials, caseStudies, caseStudyLinkLabel } = site.trust.proof;
const realTestimonials = testimonials.filter((t) => isReal(t.quote) && isReal(t.name) && isReal(t.company));
const realCaseStudies = caseStudies.filter((c) => isReal(c.title) && isReal(c.href));
const visible = config.showTestimonials && (realTestimonials.length > 0 || realCaseStudies.length > 0);
---

{
  visible && (
    <div class="proof">
      <h3 class="t-heading-sm">{heading}</h3>
      {realTestimonials.length > 0 && (
        <ul class="proof__quotes" role="list">
          {realTestimonials.map((t) => (
            <li>
              <figure class="proof__quote">
                <blockquote class="t-subheading">{t.quote}</blockquote>
                <figcaption class="t-body-sm">
                  {t.name}, {t.role}, {t.company}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )}
      {realCaseStudies.length > 0 && (
        <ul class="proof__cases" role="list">
          {realCaseStudies.map((c) => (
            <li class="proof__case">
              <h4 class="t-subheading">{c.title}</h4>
              <p class="t-body">{c.summary}</p>
              <a href={c.href}>
                {caseStudyLinkLabel}
                <span aria-hidden="true"> →</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  )
}

<style>
  .proof {
    display: grid;
    gap: var(--spacing-32);
  }

  .proof__quotes,
  .proof__cases {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-24);
  }

  .proof__quote,
  .proof__case {
    display: grid;
    gap: var(--spacing-16);
    height: 100%;
    margin: 0;
    padding: var(--card-padding);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-cards);
  }

  .proof__quote figcaption {
    color: var(--text-muted);
  }

  .proof__case a {
    font-size: var(--text-body-sm);
    text-transform: uppercase;
  }
</style>
