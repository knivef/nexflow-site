---
import { site } from '@v3/content/site';
import Section from '@v3/components/ui/Section.astro';
import Tabs from '@v3/components/ui/Tabs.astro';
import { renderPlaceholders } from '@v3/lib/placeholder';

const { eyebrow, heading, intro, tabsLabel, groups } = site.features;
---

<Section id="features" eyebrow={eyebrow} heading={heading} intro={intro}>
  <Tabs id="features" label={tabsLabel} tabs={groups.map(({ id, label }) => ({ id, label }))}>
    {
      groups.map((group, index) => (
        <div slot={group.id} class="features__panel">
          <div class:list={['features__intro', `features__intro--${index % 4}`]}>
            <div class="features__art" aria-hidden="true">
              <span class="features__shape features__shape--a" />
              <span class="features__shape features__shape--b" />
              <span class="features__shape features__shape--c" />
            </div>
            <p class="features__count t-caption">
              {String(index + 1).padStart(2, '0')} / {String(groups.length).padStart(2, '0')}
            </p>
            <h3 class="t-heading-sm">{group.label}</h3>
            <p class="t-body">{group.summary}</p>
          </div>
          <ul class="features__list" role="list">
            {group.items.map((item) => (
              <li class="features__item">
                <h4 class="features__title">{item.title}</h4>
                <p class="t-body" set:html={renderPlaceholders(item.body)} />
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </Tabs>
</Section>

<style>
  .features__panel {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--spacing-24);
    align-items: start;
  }

  /* Periwinkle card with a soft gradient illustration: the one coloured surface in this section. */
  .features__intro {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
    min-height: 420px;
    padding: var(--card-padding);
    border-radius: var(--radius-cards);
    background: var(--bg-elevated);
    overflow: hidden;
    isolation: isolate;
  }

  .features__intro > :not(.features__art) {
    position: relative;
  }

  .features__intro .t-body {
    color: var(--text-primary);
    max-width: 36ch;
  }

  .features__count {
    color: var(--text-secondary);
  }

  .features__art {
    position: absolute;
    right: -8%;
    bottom: -12%;
    width: 75%;
    aspect-ratio: 1;
    z-index: -1;
  }

  .features__shape {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    opacity: 0.75;
    mix-blend-mode: multiply;
  }

  .features__shape--a {
    inset: 30% 30% 0 0;
    background: radial-gradient(circle at 30% 30%, var(--color-coral), transparent 70%);
  }

  .features__shape--b {
    inset: 10% 0 25% 35%;
    background: radial-gradient(circle at 60% 40%, var(--color-sky-blue), transparent 70%);
  }

  .features__shape--c {
    inset: 45% 5% 0 30%;
    background: radial-gradient(circle at 50% 50%, var(--color-mint), transparent 70%);
  }

  .features__intro--1 .features__shape--a {
    background: radial-gradient(circle at 30% 30%, var(--color-gold), transparent 70%);
  }

  .features__intro--2 .features__shape--c {
    background: radial-gradient(circle at 50% 50%, var(--color-coral), transparent 70%);
  }

  .features__intro--3 .features__shape--b {
    background: radial-gradient(circle at 60% 40%, var(--color-mint), transparent 70%);
  }

  .features__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--spacing-32);
  }

  .features__item {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
    padding-block: var(--spacing-24);
    border-top: 1px solid var(--border-hairline);
  }

  .features__title {
    font-family: var(--font-serif);
    font-size: var(--text-subheading);
    font-weight: var(--font-weight-regular);
    line-height: var(--leading-subheading);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  @media (max-width: 1023px) {
    .features__panel {
      grid-template-columns: 1fr;
    }

    .features__intro {
      min-height: 280px;
    }

    .features__art {
      width: 50%;
    }
  }

  @media (max-width: 599px) {
    .features__list {
      grid-template-columns: 1fr;
    }

    .features__art {
      width: 70%;
      opacity: 0.6;
    }
  }
</style>
