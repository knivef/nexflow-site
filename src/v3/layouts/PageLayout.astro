---
/**
 * Shared page chrome: skip link, announcement bar, nav, main and footer.
 * Use it for every page, including future ones such as /igaming, /affiliates and /guides/[slug].
 */
import BaseLayout from '@v3/layouts/BaseLayout.astro';
import AnnouncementBar from '@v3/components/layout/AnnouncementBar.astro';
import Nav from '@v3/components/layout/Nav.astro';
import Footer from '@v3/components/layout/Footer.astro';
import VersionSwitcher from '@v3/components/layout/VersionSwitcher.astro';
import { site } from '@v3/content/site';

type Props = Parameters<typeof BaseLayout>[0];
---

<BaseLayout {...Astro.props}>
  <div id="top">
    <a class="skip-link" href="#main">{site.ui.skipLink}</a>
    <AnnouncementBar />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </div>
  <VersionSwitcher />
</BaseLayout>
