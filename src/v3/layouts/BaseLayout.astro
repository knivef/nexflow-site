---
/**
 * Document shell: <head> metadata, favicons, Open Graph, Twitter card and JSON-LD.
 * Every page uses this (usually through PageLayout). Organization schema is sitewide;
 * pages pass extra nodes (Service, FAQPage, Article) through `schema`.
 */
import '@v3/styles/global.css';
import { ANALYTICS_DOMAIN } from 'astro:env/server';
import { site } from '@v3/content/site';
import { isReal } from '@v3/lib/placeholder';
import { graph, organizationNode } from '@v3/lib/schema';
import { isPrimaryVersion } from '@v3/lib/version';

interface Props {
  title?: string;
  description?: string;
  /** Path under /public for the social image. Defaults to the site OG image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** Extra JSON-LD nodes for this page. */
  schema?: (Record<string, unknown> | null)[];
  noindex?: boolean;
}

const {
  title = site.seo.title,
  description = site.seo.description,
  image = site.seo.ogImage,
  imageAlt = site.seo.ogImageAlt,
  type = 'website',
  schema = [],
  noindex = false,
} = Astro.props;

// Astro.site comes from SITE_URL (astro.config.mjs). Canonical drops query strings and hashes.
const base = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, base).href;
const ogImage = new URL(image, base).href;
const twitterHandle = site.seo.twitterHandle.replace(/^@/, '');
const jsonLd = graph([organizationNode(base), ...schema]);
// Review versions (v2, v3) are never indexed, so they don't compete with the primary version.
const blockIndexing = noindex || !isPrimaryVersion();
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {blockIndexing && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f6f3f1" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.nav.brand} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    {isReal(twitterHandle) && <meta name="twitter:site" content={`@${twitterHandle}`} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={jsonLd} />

    {
      ANALYTICS_DOMAIN && (
        <script is:inline defer data-domain={ANALYTICS_DOMAIN} src="https://plausible.io/js/script.js" />
      )
    }
  </head>
  <body>
    <slot />
    <script>
      // In-page anchor links: move focus to the target section so keyboard and screen reader
      // users continue from there. Scrolling and the sticky nav offset are handled in CSS
      // (scroll-behavior and scroll-padding-top), which also respects prefers-reduced-motion.
      document.addEventListener('click', (event) => {
        const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
        if (!link) return;
        const id = link.getAttribute('href')!.slice(1);
        const target = id ? document.getElementById(id) : null;
        if (!target) return;
        if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>

<style is:global>
  [tabindex='-1']:focus {
    outline: none;
  }
</style>
