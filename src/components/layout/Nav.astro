---
import { site } from '@/content/site';
import Button from '@/components/ui/Button.astro';
import { pageHref } from '@/lib/links';

const { brand, brandLabel, links, merchantLink, primaryCta } = site.nav;
const { menuOpen, menuClose, mainNavLabel } = site.ui;
const href = (value: string) => pageHref(value, Astro.url.pathname);
// The nav CTA uses the Off-Black "primary pill" so the hero's Lake Blue button stays the single blue action on screen.
---

<header class="nav" data-nav>
  <div class="container nav__inner">
    <a class="nav__brand" href={href('#top')} aria-label={brandLabel}>
      <span class="nav__mark" aria-hidden="true"></span>
      <span class="nav__wordmark">{brand}</span>
    </a>

    <nav class="nav__menu" id="nav-menu" aria-label={mainNavLabel} data-nav-menu>
      <ul class="nav__links" role="list">
        {
          links.map((link) => (
            <li>
              <a class="nav__link" href={href(link.href)} data-nav-link>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="nav__merchant" href={href(merchantLink.href)}>
        {merchantLink.label}
        <span aria-hidden="true">→</span>
      </a>
      <div class="nav__menu-cta">
        <Button variant="secondary" href={href(primaryCta.href)} arrow={false} block>{primaryCta.label}</Button>
      </div>
    </nav>

    <div class="nav__actions">
      <Button variant="secondary" size="sm" href={href(primaryCta.href)} arrow={false} class="nav__bar-cta">
        {primaryCta.label}
      </Button>
      <button
        class="nav__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-menu"
        data-nav-toggle
        data-label-open={menuOpen}
        data-label-close={menuClose}
      >
        {menuOpen}
      </button>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = nav?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = nav?.querySelector<HTMLElement>('[data-nav-menu]');

  // Mobile menu: disclosure pattern. Escape closes and returns focus to the toggle.
  if (nav && toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
      nav.classList.toggle('is-open', open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 1200px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // Hairline under the nav once the page has scrolled.
  if (nav) {
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    nav.before(sentinel);
    new IntersectionObserver(([entry]) => {
      nav.classList.toggle('is-scrolled', !entry!.isIntersecting);
    }).observe(sentinel);
  }

  // Active section: the last linked section whose top has passed 40% of the viewport.
  // At the very bottom of the page the last section wins, even if it is short.
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const sections = navLinks
    .map((link) => ({ link, target: document.getElementById(link.hash.slice(1)) }))
    .filter((item): item is { link: HTMLAnchorElement; target: HTMLElement } => item.target !== null)
    .sort((a, b) => a.target.offsetTop - b.target.offsetTop);

  if (sections.length > 0) {
    let current: HTMLAnchorElement | null = null;
    let queued = false;

    const update = () => {
      queued = false;
      const line = window.innerHeight * 0.4;
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      let next: HTMLAnchorElement | null = null;
      for (const { link, target } of sections) {
        if (target.getBoundingClientRect().top <= line) next = link;
      }
      if (atBottom) next = sections[sections.length - 1]!.link;
      if (next === current) return;
      current?.removeAttribute('aria-current');
      next?.setAttribute('aria-current', 'true');
      current = next;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    window.addEventListener('resize', update);
    update();
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg-page);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .nav.is-scrolled {
    border-bottom-color: var(--border-hairline);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--spacing-32);
    min-height: var(--nav-height);
  }

  .nav__brand {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    text-decoration: none;
  }

  .nav__mark {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--text-primary);
  }

  .nav__wordmark {
    font-family: var(--font-serif);
    font-size: var(--text-subheading);
    letter-spacing: -0.02em;
  }

  .nav__menu {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-32);
  }

  .nav__links {
    display: flex;
    gap: var(--spacing-24);
  }

  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-body);
    text-transform: uppercase;
    text-decoration: none;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .nav__link:hover::after,
  .nav__link[aria-current='true']::after {
    transform: scaleX(1);
  }

  .nav__merchant {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: var(--text-body-sm);
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav__merchant:hover {
    color: var(--text-primary);
    text-decoration: underline;
  }

  .nav__actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--spacing-8);
  }

  .nav__toggle {
    display: none;
    min-height: 40px;
    padding: 10px 18px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pills);
    background: transparent;
    font-size: var(--text-caption);
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
  }

  @media (max-width: 1199px) {
    .nav__inner {
      justify-content: space-between;
    }

    .nav__toggle {
      display: inline-flex;
      align-items: center;
    }

    .nav__menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: var(--spacing-24);
      max-height: calc(100vh - var(--nav-height));
      overflow-y: auto;
      padding: var(--spacing-8) var(--page-gutter) var(--spacing-32);
      background: var(--bg-page);
      border-bottom: 1px solid var(--border-hairline);
    }

    .nav.is-open .nav__menu {
      display: flex;
    }

    .nav__links {
      flex-direction: column;
      gap: 0;
    }

    .nav__link {
      width: 100%;
      min-height: 56px;
      font-size: var(--text-label);
      border-bottom: 1px solid var(--border-hairline);
    }

    .nav__link::after {
      display: none;
    }

    .nav__link[aria-current='true'] {
      text-decoration: underline;
      text-underline-offset: 0.3em;
    }
  }

  .nav__menu-cta {
    display: none;
  }

  /* Phones: not enough room for brand, CTA and menu toggle in one row, so the CTA moves into the menu. */
  @media (max-width: 479px) {
    .nav__actions :global(.nav__bar-cta) {
      display: none;
    }

    .nav__menu-cta {
      display: block;
    }
  }
</style>
