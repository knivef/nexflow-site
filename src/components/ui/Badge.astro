---
/**
 * Pill tag. Used for MCCs, scheme programmes, pipeline nodes and status labels.
 * tone="node" matches the pipeline node tag. tone="inverse" is for dark surfaces.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
  tone?: 'node' | 'outline' | 'inverse' | 'muted';
  size?: 'sm' | 'md';
}

const { tone = 'node', size = 'md', class: className, ...rest } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`, `badge--${size}`, className]} {...rest}>
  {Astro.slots.has('icon') && <span class="badge__icon" aria-hidden="true"><slot name="icon" /></span>}
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: var(--radius-tags);
    font-family: var(--font-mono);
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .badge--md {
    padding: 12px 20px;
    font-size: var(--text-body-sm);
  }

  .badge--sm {
    padding: 6px 12px;
    font-size: var(--text-caption);
  }

  .badge--node {
    background: var(--bg-card);
    border: 1px solid var(--border-hairline);
    color: var(--text-primary);
  }

  .badge--outline {
    background: transparent;
    border: 1px solid var(--border-strong);
    color: var(--text-primary);
  }

  .badge--inverse {
    background: transparent;
    border: 1px solid var(--text-inverse);
    color: var(--text-inverse);
  }

  .badge--muted {
    background: var(--bg-wash);
    border: 1px solid transparent;
    color: var(--text-primary);
  }

  .badge__icon {
    display: inline-flex;
    width: 12px;
    height: 12px;
  }
</style>
