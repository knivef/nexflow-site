---
/**
 * Pill button. Renders an <a> when href is set, otherwise a <button>.
 * primary: Lake Blue fill, one per screen. secondary: Off-Black fill. ghost: outlined. link: text with arrow.
 */
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'ghost' | 'link';

interface Props extends Omit<HTMLAttributes<'button'>, 'type'> {
  variant?: Variant;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  size?: 'md' | 'sm';
  /** Show the trailing arrow. Defaults to true for primary and link. */
  arrow?: boolean;
  /** Stretch to fill the container width on small screens. */
  block?: boolean;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  size = 'md',
  arrow,
  block = false,
  class: className,
  ...rest
} = Astro.props;

const showArrow = arrow ?? (variant === 'primary' || variant === 'link');
const glyph = '→';
const classes = ['btn', `btn--${variant}`, `btn--${size}`, block && 'btn--block', className];
const Tag = href ? 'a' : 'button';
---

<Tag class:list={classes} href={href} type={href ? undefined : type} {...rest}>
  <span class="btn__label"><slot /></span>
  {showArrow && <span class="btn__arrow" aria-hidden="true">{glyph}</span>}
</Tag>

<style>
  /* v2: 6px rectangles, sentence case, colour-only transitions. Highlighter Yellow is the only filled colour. */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 20px;
    border: 1px solid transparent;
    border-radius: var(--radius-buttons);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--font-weight-regular);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  .btn--sm {
    min-height: 36px;
    padding: 0 14px;
    font-size: var(--text-body-sm);
  }

  .btn--primary {
    background: var(--action-primary-bg);
    color: var(--action-primary-text);
  }

  .btn--primary:hover {
    background: var(--action-primary-hover);
  }

  .btn--secondary {
    background: var(--action-secondary-bg);
    color: var(--action-secondary-text);
  }

  .btn--secondary:hover {
    background: var(--color-ink);
  }

  .btn--ghost {
    padding: 0 12px;
    background: transparent;
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  .btn--ghost:hover {
    background: var(--bg-card);
  }

  .btn--link {
    min-height: 32px;
    padding: 0 8px;
    margin-left: -8px;
    background: transparent;
    color: var(--text-primary);
  }

  .btn--link:hover {
    background: var(--bg-wash);
  }

  .btn--link:hover .btn__label {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .btn__arrow {
    font-size: 1em;
  }

  .btn:disabled,
  .btn[aria-disabled='true'] {
    background: var(--color-smoke);
    border-color: transparent;
    color: var(--text-secondary);
    cursor: not-allowed;
  }

  @media (max-width: 599px) {
    .btn--block {
      width: 100%;
    }
  }
</style>
