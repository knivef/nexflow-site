---
/**
 * Pill badge for short labels. Hairline border, never a saturated fill, so it cannot be
 * mistaken for the primary action.
 */
interface Props {
  tone?: 'default' | 'muted';
  class?: string;
}

const { tone = 'default', class: className } = Astro.props;
---

<span class={['badge', `badge--${tone}`, className].filter(Boolean).join(' ')}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-8);
    padding: 6px var(--spacing-16);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-tags);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .badge--muted {
    color: var(--text-muted);
  }
</style>
