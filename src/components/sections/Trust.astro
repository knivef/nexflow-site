---
import { BOOKING_URL } from 'astro:env/server';
import { site } from '@/content/site';
import { config } from '@/config/site.config';
import Section from '@/components/ui/Section.astro';
import Accordion from '@/components/ui/Accordion.astro';
import Button from '@/components/ui/Button.astro';
import { renderPlaceholders, isReal } from '@/lib/placeholder';

const trust = site.trust;
// v2 drops the company and regulatory facts module, the founding programme module and testimonials.
const { people, advisors, criteria, charter, security, presence, resources, contact, labels } = trust;

const html = renderPlaceholders;
const list = (items: string[]) => `<ul class="trust__checklist">${items.map((i) => `<li>${html(i)}</li>`).join('')}</ul>`;

const criteriaItems = [
  { question: criteria.lookFor.summary, answer: list(criteria.lookFor.items) },
  { question: criteria.cantPlace.summary, answer: list(criteria.cantPlace.items) },
];

const calendarUrl = isReal(BOOKING_URL) ? BOOKING_URL : contact.calendarUrl;
const contactLinks = [
  { label: contact.labels.email, value: contact.email, href: isReal(contact.email) ? `mailto:${contact.email}` : '' },
  {
    label: contact.labels.telegram,
    value: isReal(contact.telegram) ? `@${contact.telegram.replace(/^@/, '')}` : contact.telegram,
    href: isReal(contact.telegram) ? `https://t.me/${contact.telegram.replace(/^@/, '')}` : '',
  },
  { label: contact.labels.calendar, value: calendarUrl, href: isReal(calendarUrl) ? calendarUrl : '' },
];

const initials = (name: string) =>
  isReal(name)
    ? name
        .split(/\s+/)
        .map((part) => part[0])
        .slice(0, 2)
        .join('')
        .toUpperCase()
    : '';
---

<Section id="trust" eyebrow={trust.eyebrow} heading={trust.heading} intro={trust.intro}>
  <div class="trust">
    {/* 1. People */}
    <div class="trust__module">
      <header class="trust__header">
        <h3 class="t-heading-sm">{people.heading}</h3>
        <p class="t-body">{people.description}</p>
      </header>
      <ul class="trust__team" role="list">
        {
          people.members.map((member) => (
            <li class="trust__person">
              {isReal(member.photo) ? (
                <img
                  class="trust__photo"
                  src={member.photo}
                  alt={`${labels.photoOf} ${member.name}`}
                  width="96"
                  height="96"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="trust__photo trust__photo--empty" aria-hidden="true">
                  {initials(member.name)}
                </span>
              )}
              <div class="trust__person-head">
                <h4 class="t-subheading" set:html={html(member.name)} />
                <p class="t-body-sm" set:html={html(member.role)} />
              </div>
              <dl class="trust__person-facts">
                <div>
                  <dt class="t-caption">{labels.yearsInPayments}</dt>
                  <dd set:html={html(member.yearsInPayments)} />
                </div>
                <div>
                  <dt class="t-caption">{labels.previously}</dt>
                  <dd set:html={member.previousCompanies.map(html).join(', ')} />
                </div>
              </dl>
              {isReal(member.linkedin) ? (
                <a class="trust__linkedin" href={member.linkedin} rel="noopener" target="_blank">
                  {labels.linkedin}
                  <span class="visually-hidden">: {member.name}</span>
                  <span aria-hidden="true"> ↗</span>
                </a>
              ) : (
                <p class="trust__linkedin" set:html={html(member.linkedin)} />
              )}
            </li>
          ))
        }
      </ul>
    </div>

    {/* 2. Advisors: hidden while empty */}
    {
      advisors.members.length > 0 && (
        <div class="trust__module">
          <header class="trust__header">
            <h3 class="t-heading-sm">{advisors.heading}</h3>
            <p class="t-body">{advisors.description}</p>
          </header>
          <ul class="trust__advisors" role="list">
            {advisors.members.map((advisor) => (
              <li>
                <h4 class="t-subheading" set:html={html(advisor.name)} />
                <p class="t-body" set:html={html(advisor.background)} />
                {isReal(advisor.linkedin) && (
                  <a class="trust__linkedin" href={advisor.linkedin} rel="noopener" target="_blank">
                    {labels.linkedin}
                    <span class="visually-hidden">: {advisor.name}</span>
                    <span aria-hidden="true"> ↗</span>
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {/* 4. Partner criteria */}
    <div class="trust__module">
      <header class="trust__header">
        <h3 class="t-heading-sm">{criteria.heading}</h3>
        <p class="t-body">{criteria.description}</p>
      </header>
      <div class="trust__criteria">
        <Accordion items={criteriaItems} headingLevel={4} />
      </div>
    </div>

    {/* 5. Partner charter */}
    <div class="trust__module">
      <header class="trust__header">
        <h3 class="t-heading-sm">{charter.heading}</h3>
        <p class="t-body">{charter.description}</p>
      </header>
      <ol class="trust__charter" role="list">
        {
          charter.commitments.map((commitment, index) => (
            <li>
              <span class="trust__charter-num" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="t-subheading" set:html={html(commitment)} />
            </li>
          ))
        }
      </ol>
    </div>

    {/* 6. Security and compliance */}
    <div class="trust__module">
      <header class="trust__header">
        <h3 class="t-heading-sm">{security.heading}</h3>
        <p class="t-body">{security.description}</p>
      </header>
      <ul class="trust__badges" role="list">
        {
          security.items.map((item) => (
            <li class="trust__badge">
              <h4 class="trust__badge-name">{item.name}</h4>
              <p class="trust__badge-status" set:html={html(item.status)} />
              {item.detail && <p class="t-body-sm" set:html={html(item.detail)} />}
            </li>
          ))
        }
      </ul>
    </div>

    {/* 7. Industry presence */}
    <div class="trust__module">
      <header class="trust__header">
        <h3 class="t-heading-sm">{presence.heading}</h3>
        <p class="t-body">{presence.description}</p>
      </header>
      <ul class="trust__presence" role="list">
        {
          presence.items.map((item) => (
            <li class="trust__pill">
              {isReal(item.href) ? (
                <a href={item.href} rel="noopener" target="_blank">
                  {item.name}
                </a>
              ) : (
                <span set:html={html(item.name)} />
              )}
              {item.type && <span class="trust__pill-type">{item.type}</span>}
            </li>
          ))
        }
      </ul>
    </div>

    {/* 9. Resources: behind config.showResources */}
    {
      config.showResources && (
        <div class="trust__module">
          <header class="trust__header">
            <h3 class="t-heading-sm">{resources.heading}</h3>
            <p class="t-body">{resources.description}</p>
          </header>
          <ul class="trust__resources" role="list">
            {resources.items.map((resource) => (
              <li class="trust__resource">
                <h4 class="t-subheading">{resource.title}</h4>
                <p class="t-body" set:html={html(resource.summary)} />
                {isReal(resource.href) ? (
                  <Button variant="link" href={resource.href}>
                    {resources.linkLabel}
                    <span class="visually-hidden">: {resource.title}</span>
                  </Button>
                ) : (
                  <p class="t-body-sm" set:html={html(resource.href)} />
                )}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {/* 10. Talk to a human */}
    <div class="trust__module">
      <header class="trust__header">
        <h3 class="t-heading-sm">{contact.heading}</h3>
        <p class="t-body">{contact.description}</p>
      </header>
      <div class="trust__contact">
        <div class="trust__contact-person">
          {
            isReal(contact.photo) ? (
              <img
                class="trust__photo"
                src={contact.photo}
                alt={`${labels.photoOf} ${contact.name}`}
                width="96"
                height="96"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="trust__photo trust__photo--empty" aria-hidden="true">
                {initials(contact.name)}
              </span>
            )
          }
          <div>
            <h4 class="t-subheading" set:html={html(contact.name)} />
            <p class="t-body-sm" set:html={html(contact.role)} />
          </div>
        </div>
        <dl class="trust__contact-links">
          {
            contactLinks.map((link) => (
              <div class="trust__fact">
                <dt class="t-caption">{link.label}</dt>
                <dd>
                  {link.href ? (
                    <a href={link.href} rel={link.href.startsWith('http') ? 'noopener' : undefined}>
                      {link.value}
                    </a>
                  ) : (
                    <span set:html={html(link.value)} />
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</Section>

<style>
  .trust {
    display: grid;
  }

  /* Each module: label column on the left, evidence on the right, hairline between modules. */
  .trust__module,
  .trust :global(.proof) {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--spacing-24) var(--spacing-64);
    padding-block: var(--spacing-64);
    border-top: 1px solid var(--border-hairline);
  }

  .trust__module:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .trust :global(.proof) {
    grid-template-columns: 1fr;
  }

  .trust__header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
    max-width: 36ch;
  }

  /* People */
  .trust__team {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--spacing-24);
  }

  .trust__person {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
    padding: var(--spacing-32);
    border: 1px solid var(--border-hairline);
    background: var(--bg-card);
    border-radius: var(--radius-cards);
  }

  .trust__photo {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-xl);
    object-fit: cover;
  }

  .trust__photo--empty {
    display: grid;
    place-items: center;
    background: var(--bg-wash);
    font-size: var(--text-body-sm);
    color: var(--text-primary);
  }

  .trust__person-head {
    display: grid;
    gap: 4px;
  }

  .trust__person-head .t-body-sm {
    color: var(--text-secondary);
  }

  .trust__person-facts {
    display: grid;
    gap: var(--spacing-8);
    padding-top: var(--spacing-16);
    border-top: 1px solid var(--border-hairline);
  }

  .trust__person-facts dd,
  .trust__fact dd {
    margin: 4px 0 0;
    font-size: var(--text-body-sm);
    color: var(--text-primary);
  }

  .trust__linkedin {
    margin-top: auto;
    font-size: var(--text-body-sm);
  }

  .trust__advisors {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--spacing-32);
  }

  .trust__advisors li {
    display: grid;
    gap: var(--spacing-8);
    align-content: start;
  }


  .trust__contact-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-24) var(--spacing-32);
  }

  .trust__fact {
    padding-top: var(--spacing-16);
    border-top: 1px solid var(--border-hairline);
  }





  /* Criteria checklist inside the accordion */
  .trust__criteria :global(.accordion__summary) {
    padding-block: var(--spacing-24);
  }

  .trust__criteria :global(.accordion__item:first-child) {
    border-top: 1px solid var(--border-hairline);
  }

  .trust__criteria :global(.trust__checklist) {
    display: grid;
    gap: var(--spacing-16);
    padding: 0;
    list-style: none;
  }

  .trust__criteria :global(.trust__checklist li) {
    position: relative;
    padding-left: var(--spacing-32);
    color: var(--text-primary);
  }

  .trust__criteria :global(.accordion__item:first-child .trust__checklist li::before) {
    content: '✓';
    position: absolute;
    left: 0;
  }

  .trust__criteria :global(.accordion__item:last-child .trust__checklist li::before) {
    content: '×';
    position: absolute;
    left: 0;
  }

  /* Charter: the one inverted panel in this section. */
  .trust__charter {
    display: grid;
    padding: var(--spacing-8) var(--card-padding);
    border-radius: var(--radius-cards);
    background: var(--bg-inverse);
    color: var(--text-inverse);
  }

  .trust__charter .t-subheading {
    color: var(--text-inverse);
  }

  .trust__charter :global(.placeholder) {
    font-size: var(--text-body);
  }

  .trust__charter li {
    display: flex;
    gap: var(--spacing-24);
    align-items: baseline;
    padding-block: var(--spacing-24);
  }

  .trust__charter li + li {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .trust__charter-num {
    flex-shrink: 0;
    font-size: var(--text-body-sm);
    color: var(--accent-active);
  }

  /* Security badges */
  .trust__badges {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--spacing-16);
  }

  .trust__badge {
    display: grid;
    gap: var(--spacing-8);
    align-content: start;
    padding: var(--spacing-24);
    border: 1px solid var(--border-hairline);
    background: var(--bg-card);
    border-radius: var(--radius-2xl);
  }

  .trust__badge-name {
    font-size: var(--text-body);
  }

  .trust__badge-status {
    font-size: var(--text-body-sm);
    color: var(--text-secondary);
  }

  /* Industry presence */
  .trust__presence {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: var(--spacing-8);
  }

  .trust__pill {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-8);
    padding: 12px 20px;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-tags);
    background: var(--bg-card);
    font-size: var(--text-body-sm);
  }

  .trust__pill-type {
    color: var(--text-muted);
  }


  /* Resources */
  .trust__resources {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--spacing-24);
  }

  .trust__resource {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
    padding: var(--spacing-32);
    border: 1px solid var(--border-hairline);
    background: var(--bg-card);
    border-radius: var(--radius-cards);
  }

  /* Contact */
  .trust__contact {
    display: grid;
    gap: var(--spacing-32);
    padding: var(--card-padding);
    border: 1px solid var(--border-hairline);
    background: var(--bg-card);
    border-radius: var(--radius-cards);
  }

  .trust__contact-person {
    display: flex;
    align-items: center;
    gap: var(--spacing-24);
  }

  .trust__contact-links {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .trust__contact-links a {
    overflow-wrap: anywhere;
  }

  @media (max-width: 1023px) {
    .trust__module {
      grid-template-columns: 1fr;
      padding-block: var(--spacing-40);
    }

    .trust__header {
      max-width: none;
    }
  }

  @media (max-width: 599px) {
    .trust__contact-links {
      grid-template-columns: 1fr;
    }

    .trust__charter li {
      gap: var(--spacing-16);
    }
  }
</style>
