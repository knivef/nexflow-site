---
import { site } from '@/content/site';
import { config } from '@/config/site.config';
import Field from '@/components/ui/Field.astro';
import Button from '@/components/ui/Button.astro';
import { renderPlaceholders } from '@/lib/placeholder';

const { heading, body, form } = site.merchants;
// The referral form's submission handling is shared with the #apply form and wired up in that step.
---

<section id="merchants" class="merchants" aria-labelledby="merchants-heading">
  <div class="container">
    <div class="merchants__box">
      <div class="merchants__copy">
        <h2 id="merchants-heading" class="t-subheading">{heading}</h2>
        <p class="t-body">{body}</p>
      </div>

      {
        config.merchantReferralForm && (
          <form class="merchants__form" data-form="merchant-referral" novalidate>
            <h3 class="t-body merchants__form-heading">{form.heading}</h3>
            <p class="t-body-sm">{form.intro}</p>
            <div class="merchants__fields">
              {form.fields.map((field) => (
                <Field
                  kind={field.kind}
                  name={field.name}
                  label={field.label}
                  type={field.type}
                  required={field.required}
                  hint={field.hint}
                  placeholder={field.placeholder}
                  autocomplete={field.autocomplete as never}
                  options={field.options}
                />
              ))}
            </div>
            <p class="t-body-sm" set:html={renderPlaceholders(form.privacyNote)} />
            <Button variant="ghost" type="submit" arrow={false}>
              {form.submitLabel}
            </Button>
          </form>
        )
      }
    </div>
  </div>
</section>

<style>
  .merchants {
    padding-block: var(--spacing-40);
  }

  .merchants__box {
    display: grid;
    gap: var(--spacing-32);
    padding: var(--spacing-32);
    border: 1px dashed var(--border-control);
    border-radius: var(--radius-2xl);
  }

  .merchants__copy {
    display: grid;
    gap: var(--spacing-8);
    max-width: 72ch;
  }

  .merchants__form {
    display: grid;
    gap: var(--spacing-16);
    padding-top: var(--spacing-24);
    border-top: 1px solid var(--border-hairline);
  }

  .merchants__form-heading {
    font-weight: var(--font-weight-medium);
    color: var(--text-primary);
  }

  .merchants__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-16);
  }

  .merchants__form :global(.btn) {
    justify-self: start;
  }

  @media (max-width: 599px) {
    .merchants__fields {
      grid-template-columns: 1fr;
    }
  }
</style>
