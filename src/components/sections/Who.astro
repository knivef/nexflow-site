---
import { site } from '@/content/site';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';

const { eyebrow, heading, intro, worksWith, notWith, merchantNote } = site.who;
const columns = [
  { ...worksWith, tone: 'yes', marker: '+' },
  { ...notWith, tone: 'no', marker: '×' },
] as const;
---

<Section id="who" eyebrow={eyebrow} heading={heading} intro={intro}>
  <div class="who__grid">
    {
      columns.map((column) => (
        <div class:list={['who__column', `who__column--${column.tone}`]}>
          <h3 class="who__heading t-subheading">{column.heading}</h3>
          <ul class="who__list" role="list">
            {column.items.map((item) => (
              <li class="who__item">
                <span class="who__marker" aria-hidden="true">
                  {column.marker}
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <p class="who__note t-body">
    {merchantNote.text}
    <Button variant="link" href={merchantNote.link.href}>{merchantNote.link.label}</Button>
  </p>
</Section>

<style>
  .who__grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--spacing-24);
  }

  .who__column {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-24);
    padding: var(--card-padding);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-cards);
  }

  .who__column--no {
    background: transparent;
    border-style: dashed;
  }

  .who__list {
    display: grid;
  }

  .who__column--yes .who__list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--spacing-32);
  }

  .who__item {
    display: flex;
    gap: var(--spacing-16);
    padding-block: var(--spacing-16);
    border-top: 1px solid var(--border-hairline);
    color: var(--text-primary);
  }

  .who__column--no .who__item {
    color: var(--text-secondary);
  }

  .who__marker {
    flex-shrink: 0;
    width: 1ch;
    font-weight: var(--font-weight-medium);
  }

  .who__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-8) var(--spacing-16);
    margin-top: var(--spacing-40);
  }

  @media (max-width: 1023px) {
    .who__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 599px) {
    .who__column--yes .who__list {
      grid-template-columns: 1fr;
    }
  }
</style>
