---
import { site } from '@/content/site';
import Section from '@/components/ui/Section.astro';
import Accordion from '@/components/ui/Accordion.astro';
import { renderPlaceholders } from '@/lib/placeholder';

const { eyebrow, heading, intro, lastUpdatedLabel, items } = site.faq;
const html = renderPlaceholders;

const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

// The lead paragraph is the direct answer and is kept first, so snippets and AI answers quote it whole.
const accordionItems = items.map((item) => ({
  id: `faq-${item.id}`,
  question: item.question,
  answer: [
    `<p class="faq__lead">${html(item.lead)}</p>`,
    ...item.detail.map((paragraph) => `<p>${html(paragraph)}</p>`),
    item.list ? `<ul class="faq__list">${item.list.map((line) => `<li>${html(line)}</li>`).join('')}</ul>` : '',
    item.lastUpdated
      ? `<p class="faq__updated">${html(lastUpdatedLabel)}: <time datetime="${item.lastUpdated}">${formatDate(item.lastUpdated)}</time></p>`
      : '',
  ].join(''),
}));
---

<Section id="faq" eyebrow={eyebrow} heading={heading} intro={intro}>
  <div class="faq">
    <Accordion items={accordionItems} headingLevel={3} />
  </div>
</Section>

<style>
  .faq {
    max-width: 1040px;
  }

  .faq :global(.accordion__item:first-child) {
    border-top: 1px solid var(--border-hairline);
  }

  .faq :global(.accordion__summary) {
    padding-block: var(--spacing-32);
  }

  .faq :global(.accordion__answer) {
    display: grid;
    gap: var(--spacing-16);
  }

  .faq :global(.accordion__answer p + p) {
    margin-top: 0;
  }

  .faq :global(.faq__lead) {
    font-size: var(--text-body-lg);
    line-height: var(--leading-body-lg);
    color: var(--text-primary);
  }

  .faq :global(.faq__list) {
    display: grid;
    gap: var(--spacing-8);
    padding-left: 1.25em;
  }

  .faq :global(.faq__updated) {
    font-size: var(--text-caption);
    text-transform: uppercase;
    color: var(--text-muted);
  }
</style>
