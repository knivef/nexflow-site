---
/**
 * Form field with label, optional hint and error slot, wired with aria-describedby.
 * kind: text-like input, textarea, select, checkbox, radio group, or checkboxes (multi-select group).
 * Errors are rendered empty and filled by the form script, so they are announced via aria-live.
 */
import type { HTMLAttributes } from 'astro/types';
import { site } from '@v2/content/site';

interface Option {
  value: string;
  label: string;
}

type InputType = 'text' | 'email' | 'url' | 'tel' | 'number';

interface Props {
  kind?: 'input' | 'textarea' | 'select' | 'checkbox' | 'radio' | 'checkboxes';
  name: string;
  label: string;
  type?: InputType;
  required?: boolean;
  hint?: string;
  placeholder?: string;
  options?: Option[];
  autocomplete?: HTMLAttributes<'input'>['autocomplete'];
  /** Optional id override. Defaults to field-{name}. */
  id?: string;
  rows?: number;
}

const {
  kind = 'input',
  name,
  label,
  type = 'text',
  required = false,
  hint,
  placeholder,
  options = [],
  autocomplete,
  id = `field-${name}`,
  rows = 4,
} = Astro.props;

const hintId = hint ? `${id}-hint` : undefined;
const errorId = `${id}-error`;
const describedBy = [hintId, errorId].filter(Boolean).join(' ');
const isGroup = kind === 'radio' || kind === 'checkboxes';
const groupInputType = kind === 'radio' ? 'radio' : 'checkbox';
---

{
  isGroup ? (
    <fieldset class="field field--group" id={id} aria-describedby={describedBy} data-field={name}>
      <legend class="field__label">
        {label}
        {required && <span class="field__required"> {site.ui.requiredMarker}</span>}
      </legend>
      {hint && (
        <p class="field__hint" id={hintId}>
          {hint}
        </p>
      )}
      <div class="field__options">
        {options.map((option, index) => (
          <label class="field__choice">
            <input
              type={groupInputType}
              name={name}
              value={option.value}
              id={`${id}-${index}`}
              required={kind === 'radio' ? required : undefined}
            />
            <span>{option.label}</span>
          </label>
        ))}
      </div>
      <p class="field__error" id={errorId} aria-live="polite" />
    </fieldset>
  ) : kind === 'checkbox' ? (
    <div class="field field--checkbox">
      <label class="field__choice" for={id}>
        <input type="checkbox" id={id} name={name} required={required} aria-describedby={describedBy} />
        <span>
          {label}
          {required && <span class="field__required"> {site.ui.requiredMarker}</span>}
        </span>
      </label>
      {hint && (
        <p class="field__hint" id={hintId}>
          {hint}
        </p>
      )}
      <p class="field__error" id={errorId} aria-live="polite" />
    </div>
  ) : (
    <div class="field">
      <label class="field__label" for={id}>
        {label}
        {required && <span class="field__required"> {site.ui.requiredMarker}</span>}
      </label>
      {hint && (
        <p class="field__hint" id={hintId}>
          {hint}
        </p>
      )}
      {kind === 'textarea' ? (
        <textarea
          class="field__control"
          id={id}
          name={name}
          rows={rows}
          required={required}
          placeholder={placeholder}
          aria-describedby={describedBy}
        />
      ) : kind === 'select' ? (
        <div class="field__select">
          <select class="field__control" id={id} name={name} required={required} aria-describedby={describedBy}>
            <option value="">{placeholder ?? site.ui.selectPlaceholder}</option>
            {options.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
          <span class="field__chevron" aria-hidden="true">↓</span>
        </div>
      ) : (
        <input
          class="field__control"
          id={id}
          name={name}
          type={type}
          required={required}
          placeholder={placeholder}
          autocomplete={autocomplete}
          aria-describedby={describedBy}
        />
      )}
      <p class="field__error" id={errorId} aria-live="polite" />
    </div>
  )
}

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
    min-width: 0;
    border: 0;
    padding: 0;
  }

  .field__label {
    padding: 0;
    font-size: var(--text-body-sm);
    color: var(--text-primary);
  }

  .field__required {
    color: var(--text-muted);
  }

  .field__hint {
    font-size: var(--text-body-sm);
    color: var(--text-muted);
  }

  .field__control {
    width: 100%;
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid var(--border-control);
    border-radius: var(--radius-inputs);
    background: var(--bg-card);
    color: var(--text-primary);
    font-size: var(--text-body);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  textarea.field__control {
    resize: vertical;
    min-height: 120px;
  }

  .field__control::placeholder {
    color: var(--text-muted);
  }

  .field__control:hover {
    border-color: var(--border-strong);
  }

  .field__control:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 1px;
    border-color: var(--focus-ring);
  }

  .field__control[aria-invalid='true'] {
    border-color: var(--color-error);
  }

  .field__select {
    position: relative;
  }

  .field__select select {
    appearance: none;
    padding-right: 48px;
  }

  .field__chevron {
    position: absolute;
    top: 50%;
    right: 20px;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .field__options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-8);
  }

  .field__choice {
    display: inline-flex;
    align-items: flex-start;
    gap: 12px;
    font-size: var(--text-body);
    color: var(--text-primary);
    cursor: pointer;
  }

  .field--group .field__choice {
    position: relative;
    align-items: center;
    min-height: 40px;
    padding: 8px 14px;
    border: 1px solid var(--border-control);
    border-radius: var(--radius-tags);
    background: var(--bg-card);
    font-size: var(--text-body-sm);
  }

  .field--group .field__choice:has(input:checked) {
    background: var(--accent-active);
    border-color: var(--text-primary);
    color: var(--text-primary);
  }

  /* A tick as well as the colour change, so the selected state doesn't rely on colour alone. */
  .field--group .field__choice:has(input:checked)::before {
    content: '✓';
  }

  .field--group:has([aria-invalid='true']) .field__choice {
    border-color: var(--color-error);
  }

  .field--group .field__choice:has(input:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .field__choice input {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    accent-color: var(--color-ink);
  }

  .field--group .field__choice input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .field__error {
    min-height: 0;
    font-size: var(--text-body-sm);
    color: var(--color-error);
  }

  .field__error:empty {
    display: none;
  }
</style>
