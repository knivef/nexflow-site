---
/**
 * Floating switcher between the site versions (/, /v2/, /v3/), all on one deployment.
 * Switching keeps the visitor's place: the current #section is carried over.
 */
import { site } from '@v2/content/site';
import { config } from '@v2/config/site.config';
import { currentVersionId } from '@v2/lib/version';
import { VERSIONS } from '@shared/versions';

const current = currentVersionId();
const visible = config.showVersionSwitcher && VERSIONS.length > 1;
---

{
  visible && (
    <nav class="versions" aria-label={site.ui.versionSwitcherLabel} data-versions>
      <span class="versions__prefix" aria-hidden="true">
        {site.ui.versionPrefix}
      </span>
      <ul role="list">
        {VERSIONS.map((version) => (
          <li>
            <a
              href={version.path}
              aria-current={version.id === current ? 'page' : undefined}
              data-version-link
            >
              <span class="visually-hidden">{site.ui.versionPrefix} </span>
              {version.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-version-link]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (link.getAttribute('aria-current') === 'page') {
        event.preventDefault();
        return;
      }
      const target = new URL(link.href);
      target.hash = location.hash;
      link.href = target.href;
    });
  });
</script>

<style>
  .versions {
    position: fixed;
    left: var(--spacing-16);
    bottom: var(--spacing-16);
    z-index: 60;
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
    padding: 6px 6px 6px 14px;
    border-radius: var(--radius-pills);
    background: var(--bg-inverse);
    color: var(--text-inverse);
    border: 1px solid rgba(255, 255, 255, 0.24);
    box-shadow: var(--shadow-md);
    font-size: var(--text-caption);
    text-transform: uppercase;
  }

  .versions ul {
    display: flex;
    gap: 2px;
  }

  .versions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    min-height: 28px;
    padding: 0 10px;
    border-radius: var(--radius-pills);
    color: var(--text-inverse);
    text-decoration: none;
  }

  .versions a:hover {
    background: rgba(246, 243, 241, 0.15);
  }

  .versions a[aria-current='page'] {
    background: var(--text-inverse);
    color: var(--bg-inverse);
  }

  .versions a:focus-visible {
    outline-color: var(--text-inverse);
  }

  @media print {
    .versions {
      display: none;
    }
  }
</style>
