---
import { site } from '@v2/content/site';
import { config } from '@v2/config/site.config';
import Section from '@v2/components/ui/Section.astro';
import Button from '@v2/components/ui/Button.astro';
import { renderPlaceholders } from '@v2/lib/placeholder';

const content = site.foundingPartners;
const { foundingSpotsTotal: total, foundingSpotsFilled: filled, showFoundingProgress } = config;

const spots = total > 0 ? String(total) : content.spotsPlaceholder;
const heading = content.headingTemplate.replace('{spots}', spots);

// Progress only shows with the flag on and sane numbers. Never invent a count.
const showProgress =
  showFoundingProgress && Number.isInteger(total) && Number.isInteger(filled) && total > 0 && filled >= 0 && filled <= total;
const fill = (template: string) =>
  template
    .replace('{filled}', String(filled))
    .replace('{total}', String(total))
    .replace('{left}', String(total - filled));
const percent = showProgress ? Math.round((filled / total) * 100) : 0;
---

<Section id="founding-partners" eyebrow={content.eyebrow} intro={content.intro} label={site.ui.sectionLabels['founding-partners']}>
  <div class="founding">
    <h2 class="t-heading-lg founding__heading" set:html={renderPlaceholders(heading)} />

    {
      showProgress && (
        <div class="founding__progress">
          <div class="founding__progress-text">
            <p class="t-body">{fill(content.progressLabel)}</p>
            <p class="t-caption">{fill(content.progressRemaining)}</p>
          </div>
          <div class="founding__bar" aria-hidden="true">
            <span style={`width: ${percent}%`} />
          </div>
        </div>
      )
    }

    <div class="founding__grid">
      {
        [content.gets, content.asks].map((group) => (
          <div class="founding__card">
            <h3 class="t-subheading">{group.heading}</h3>
            <ul class="founding__list" role="list">
              {group.items.map((item) => (
                <li set:html={renderPlaceholders(item)} />
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="founding__cta">
      <Button variant="primary" href={content.cta.href} data-apply-intent={content.cta.intent}>
        {content.cta.label}
      </Button>
    </div>
  </div>
</Section>

<script>
  // "Apply for a founding spot": record the intent so the #apply form can pre-select it.
  // The intent goes in the URL (?partnership=founding) so it also survives a reload or a shared link,
  // and a custom event tells an already-loaded form to update.
  document.querySelectorAll<HTMLAnchorElement>('[data-apply-intent]').forEach((link) => {
    link.addEventListener('click', () => {
      const intent = link.dataset.applyIntent ?? '';
      const url = new URL(window.location.href);
      url.searchParams.set('partnership', intent);
      history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
      document.dispatchEvent(new CustomEvent('nexflow:apply-intent', { detail: { intent } }));
    });
  });
</script>

<style>
  .founding {
    display: grid;
    gap: var(--section-gap);
  }

  .founding__heading {
    max-width: 22ch;
  }

  .founding__progress {
    display: grid;
    gap: var(--spacing-16);
    max-width: 640px;
  }

  .founding__progress-text {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--spacing-16);
  }

  .founding__progress-text .t-body {
    color: var(--text-primary);
  }

  .founding__bar {
    height: 8px;
    border-radius: var(--radius-pills);
    background: var(--color-periwinkle-mist);
    overflow: hidden;
  }

  .founding__bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--text-primary);
  }

  .founding__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-24);
  }

  .founding__card {
    display: grid;
    gap: var(--spacing-24);
    align-content: start;
    padding: var(--card-padding);
    border: 1px solid var(--border-hairline);
    background: var(--bg-card);
    border-radius: var(--radius-cards);
  }

  .founding__list {
    display: grid;
  }

  .founding__list li {
    padding-block: var(--spacing-16);
    border-top: 1px solid var(--border-hairline);
    color: var(--text-primary);
  }

  @media (max-width: 767px) {
    .founding__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
